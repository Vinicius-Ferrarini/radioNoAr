[resource]
script = ExtResource("1_cons")
id = "c_valvula_anunciada"
delay_nights = 1
condition = 1
meter_deltas = {
"audience_trust": -3,
"regime_attention": 10
}
morning_headline = "TRÊS PESSOAS SÃO DETIDAS DE MADRUGADA EM PONTO DE ENTREGA NO CENTRO"

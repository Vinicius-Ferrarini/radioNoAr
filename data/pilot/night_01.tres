[resource]
script = ExtResource("n")
night = 1
title = "A nossa frequência"
intro = "19h55. Cheiro de café, transmissor quente. Hoje tem aniversário, futebol e recados.\nAbra o celular ou as cartas. Arraste quatro pessoas para os blocos e escolha o que dizer. O caderno ajuda a conferir."
allow_breaks = true
propaganda_quota = 0

[sub_resource type="Resource" id="call"]
script = ExtResource("r")
caller = "Célia / Rua Bandeira"
transcript = "Eu ouvi vocês ontem. Não entendo de política. Só quero poder ligar quando o Antônio não voltar."
trigger_seconds = 3.0
aired_reaction = "Nilo deixa o café na mesa sem fazer piada. A linha continua aberta."
cut_reaction = "A linha fica muda. Nilo olha para o telefone, depois para você."
aired_consequence_ids = Array[String](["p_n3_air"])
cut_consequence_ids = Array[String](["p_n3_cut"])

[resource]
script = ExtResource("n")
night = 3
title = "Quem ficou ouvindo"
intro = "Hoje chegaram ofertas de ajuda e pedidos de silêncio. Escolha seus compromissos. Esta é a última noite da abertura."
allow_breaks = true
propaganda_quota = 1
call = SubResource("call")
baseline_headline = "TRÊS NOITES NO AR. A PRÓXIMA PROGRAMAÇÃO JÁ NÃO SERÁ A MESMA."
inbox = Array[ExtResource("i")]([SubResource("p3_rui_public"), SubResource("p3_rui_private"), SubResource("p3_celia"), SubResource("p3_oficial"), SubResource("p3_ajuda"), SubResource("p3_oficina")])
opening_flag = "rui_aired"
opening_if_set = "Rui foi retirado da escala depois que seu nome saiu no ar. Ele voltou procurando trabalho."
opening_if_unset = "O nome de Rui ficou protegido. Ele voltou com uma rota alternativa e uma cobrança."

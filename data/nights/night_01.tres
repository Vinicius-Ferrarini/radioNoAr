[sub_resource type="Resource" id="item_c"]
script = ExtResource("3_item")
id = "n01_carta_a_mendes"
type = 4
channel = 1
sender_id = "irma_de_a_mendes"
received_at = "chegou hoje cedo"
headline = "Uma carta pedindo um nome no ar"
body = "Meu irmão saiu para o turno da noite na quinta-feira e não voltou. Na delegacia dizem que não há registro. No hospital dizem que não há registro. Se o senhor disser o nome dele no ar, A. Mendes, quem viu alguma coisa vai saber que tem gente procurando. Eu sei o que estou pedindo ao senhor. Escrevi esta carta três vezes antes de botar no correio."
claims = Array[ExtResource("1_claim")]([SubResource("claim_c_nome")])
framings = Array[ExtResource("2_framing")]([SubResource("fr_c_lido"), SubResource("fr_c_verdade"), SubResource("fr_c_suavizar"), SubResource("fr_c_descartar")])
counts_for_quota = false
is_fraudulent = false

; ---------------------------------------------------------------------
; D — O envelope azul. A proposta é real; o que o caderno denuncia é
; que ela passou pela censura antes de chegar. Descartar é aceitar.
; ---------------------------------------------------------------------

[sub_resource type="Resource" id="claim_d_lacre"]
script = ExtResource("1_claim")
id = "c_d_lacre"
field = 5
key = "envelope_azul"

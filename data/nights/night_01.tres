[sub_resource type="Resource" id="item_d"]
script = ExtResource("3_item")
id = "n01_carta_envelope_azul"
type = 0
channel = 1
sender_id = "remetente_sem_nome"
received_at = "estava na porta"
headline = "Envelope azul, sem remetente"
body = "Prezado senhor. Reconhecemos a dificuldade de manter uma emissora independente em funcionamento nestes tempos. Duzentos litros de combustível podem ser entregues na sexta-feira, sem nota e sem constrangimento para ninguém, desde que a programação desta semana não mencione a paralisação do turno da noite. Não é preciso responder a esta carta. Basta não falar."
claims = Array[ExtResource("1_claim")]([SubResource("claim_d_lacre")])
framings = Array[ExtResource("2_framing")]([SubResource("fr_d_verdade"), SubResource("fr_d_inflamar"), SubResource("fr_d_descartar")])
counts_for_quota = false
is_fraudulent = false


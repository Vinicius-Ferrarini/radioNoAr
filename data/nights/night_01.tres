id = "n01_msg_valvula"
type = 1
channel = 0
sender_id = "oficina_portao_doze"
received_at = "20:58"
headline = "Uma válvula 807 em troca de trinta segundos"
body = "Tenho uma válvula 807 nova na caixa, dessas que o seu transmissor come de dois em dois meses. Não quero dinheiro. Quero que o senhor anuncie no ar que a oficina do Portão Doze está aberta e atende quem precisar. Entrego hoje mesmo, onze da noite, na esquina do Centro com a praça. É só mandar alguém de confiança."
claims = Array[ExtResource("1_claim")]([SubResource("claim_e_entrega")])
framings = Array[ExtResource("2_framing")]([SubResource("fr_e_lido"), SubResource("fr_e_verdade"), SubResource("fr_e_descartar")])
counts_for_quota = false
is_fraudulent = true


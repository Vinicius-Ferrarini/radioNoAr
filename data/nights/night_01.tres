[sub_resource type="Resource" id="item_b"]
script = ExtResource("3_item")
id = "n01_msg_toledo"
type = 2
channel = 0
sender_id = "j_toledo"
received_at = "20:15"
headline = "Vizinho da Aurora estaria entregando nomes"
body = "Aqui é o Toledo, o senhor me conhece. Ontem à noite eu vi com estes olhos o sujeito do sobrado da Rua Aurora, aquele do portão verde, conversando com dois homens dentro de um carro preto e passando uma lista na mão. Fala o número do sobrado no ar que o bairro inteiro sabe de quem eu estou falando."
claims = Array[ExtResource("1_claim")]([SubResource("claim_b_local"), SubResource("claim_b_remetente")])
framings = Array[ExtResource("2_framing")]([SubResource("fr_b_lido"), SubResource("fr_b_verdade"), SubResource("fr_b_inflamar"), SubResource("fr_b_descartar")])
counts_for_quota = false
is_fraudulent = true

; ---------------------------------------------------------------------

; ---------------------------------------------------------------------
; A — Dona Célia, a fila do pão. Verdadeiro, e o caderno não alcança:
; não há nenhuma entrada sobre a Rua Bandeira. Não achar nada aqui não
; prova nada.
; ---------------------------------------------------------------------

[sub_resource type="Resource" id="claim_a_local"]
script = ExtResource("1_claim")
id = "c_a_local"
field = 0
key = "rua_bandeira"
excerpt = "a fila do pão hoje dobrou o quarteirão"
contradicted_by = Array[int]([1, 2])

[sub_resource type="Resource" id="fr_a_lido"]
script = ExtResource("2_framing")
script_id = "r_celia_lido"
kind = 0
immediate_deltas = {
"audience_trust": 2
}

[sub_resource type="Resource" id="fr_a_verdade"]
script = ExtResource("2_framing")
script_id = "r_celia_verdade"
kind = 1
immediate_deltas = {
"audience_trust": 4,
"integrity": 3,
"street_heat": 2
}

[sub_resource type="Resource" id="fr_a_suavizar"]
script = ExtResource("2_framing")
script_id = "r_celia_suavizar"
kind = 2
immediate_deltas = {
"audience_trust": -1,
"integrity": -2,
"street_heat": -3
}

[sub_resource type="Resource" id="fr_a_inflamar"]
script = ExtResource("2_framing")
script_id = "r_celia_inflamar"
kind = 3
immediate_deltas = {
"audience_trust": 5,
"street_heat": 7
}
consequence_ids = Array[String](["c_fila_inflamada"])

[sub_resource type="Resource" id="fr_a_descartar"]
script = ExtResource("2_framing")
kind = 5
immediate_deltas = {}

[sub_resource type="Resource" id="item_a"]
script = ExtResource("3_item")
id = "n01_msg_dona_celia"
type = 3
channel = 0
sender_id = "dona_celia"
received_at = "19:42"
headline = "A fila da Bandeira dobrou o quarteirão"
body = "Moço, é a Célia da Rua Bandeira. Não é reclamação, é só pro senhor saber: a fila do pão hoje dobrou o quarteirão e passou da esquina da farmácia. Tinha gente sentada no meio-fio com a senha na mão desde as quatro da manhã. Ninguém falou em greve nem em nada disso, é fila mesmo. Mas eu moro aqui faz quarenta anos e nunca vi assim."
claims = Array[ExtResource("1_claim")]([SubResource("claim_a_local")])
framings = Array[ExtResource("2_framing")]([SubResource("fr_a_lido"), SubResource("fr_a_verdade"), SubResource("fr_a_suavizar"), SubResource("fr_a_inflamar"), SubResource("fr_a_descartar")])
counts_for_quota = false
is_fraudulent = false

; ---------------------------------------------------------------------
; B — Denúncia do J. Toledo. FALSA, e detectável por dois caminhos:
; a Rua Aurora está evacuada e o próprio Toledo já mentiu antes.
; ---------------------------------------------------------------------

[sub_resource type="Resource" id="claim_b_local"]
script = ExtResource("1_claim")
id = "c_b_local"
field = 0
key = "rua_aurora"
excerpt = "o sujeito do sobrado da Rua Aurora, aquele do portão verde"
contradicted_by = Array[int]([1])

[sub_resource type="Resource" id="claim_b_remetente"]
script = ExtResource("1_claim")
id = "c_b_remetente"
field = 8
key = "j_toledo"
excerpt = "Aqui é o Toledo, o senhor me conhece"
contradicted_by = Array[int]([6])


[sub_resource type="Resource" id="item_f"]
script = ExtResource("3_item")
id = "n01_propaganda_normalidade"
type = 5
channel = 3
sender_id = "ministerio_das_comunicacoes"
received_at = "21:00 — obrigatório"
headline = "Comunicado oficial nº 114"
body = "O Ministério das Comunicações informa à população que não há qualquer paralisação em curso no país, e que as filas registradas em alguns bairros decorrem de procura espontânea e temporária. Informa ainda que a Rua Aurora amanheceu em plena normalidade, com comércio aberto e circulação regular de moradores. Reitera que a divulgação de informação não confirmada constitui crime previsto nas medidas de emergência."
claims = Array[ExtResource("1_claim")]([SubResource("claim_f_aurora")])
framings = Array[ExtResource("2_framing")]([SubResource("fr_f_lido"), SubResource("fr_f_ironia"), SubResource("fr_f_descartar")])
counts_for_quota = true
is_fraudulent = true


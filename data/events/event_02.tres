[ext_resource type="Script" path="res://scripts/core/radio_event.gd" id="2_o5e7v"]

[sub_resource type="Resource" id="Resource_7bdrr"]
script = ExtResource("1_xj3dh")
id = "event_02_truth"
label = "Ler a lista no ar, sem cortes"
response_text = "Recebemos uma lista de nomes que estão sendo monitorados desde a manifestação. Se você está entre eles, tem o direito de saber — e o direito de se proteger."
power_delta = -15
integrity_delta = 10

[sub_resource type="Resource" id="Resource_2pdhk"]
script = ExtResource("1_xj3dh")
id = "event_02_crowd"
label = "Guardar a lista e não comentar no ar"
response_text = "Não temos como confirmar essa informação de forma independente esta noite, então preferimos não repercuti-la sem mais apuração."
power_delta = 5
stance = 1

[sub_resource type="Resource" id="Resource_aq1qc"]
script = ExtResource("1_xj3dh")
id = "event_02_attack"
label = "Usar a lista pra insinuar culpa no ar"
response_text = "Interessante quantos nomes conhecidos apareceram nessa lista. Quem anda perto demais do fogo, se queima."
power_delta = 20
integrity_delta = -15
stance = 2

[resource]
script = ExtResource("2_o5e7v")
id = "event_02"
night = 2
headline = "Uma ligação que não devia existir"
body = "Passa da meia-noite quando o telefone direto do estúdio toca — a linha que só uns poucos números têm. Do outro lado, uma voz que você reconhece de dentro do próprio governo oferece uma lista com os nomes que a polícia está monitorando desde a marcha. \"É só pra vocês se cuidarem\", ela diz, antes de desligar."
choices = Array[ExtResource("1_xj3dh")]([SubResource("Resource_7bdrr"), SubResource("Resource_2pdhk"), SubResource("Resource_aq1qc")])

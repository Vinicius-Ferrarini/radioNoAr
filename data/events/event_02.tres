night = 2
headline = "A lista que ninguém quer confirmar"
body = "Rumores de uma lista de \"agitadores\" circulam entre os ouvintes. Um contato dentro do governo liga fora do expediente, oferecendo confirmar — ou desmentir — dependendo do que você perguntar."

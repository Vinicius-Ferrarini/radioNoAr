[sub_resource type="Resource" id="Resource_yd868"]
script = ExtResource("1_7ahsg")
id = "event_01_truth"
label = "Dizer ao vivo que não foi instabilidade"
response_text = "Não foi instabilidade nenhuma. As luzes aqui dentro nem piscaram. Alguém, em algum lugar, decidiu que vocês não deviam ouvir aquela frase até o fim."
power_delta = -15
integrity_delta = 10

[sub_resource type="Resource" id="Resource_k2icd"]
script = ExtResource("1_7ahsg")
id = "event_01_crowd"
label = "Ler a nota do Ministério sem questionar"
response_text = "O Ministério das Comunicações informa que houve uma instabilidade técnica pontual na transmissão, já normalizada. Seguimos com a programação."
power_delta = 5
stance = 1

[sub_resource type="Resource" id="Resource_seidi"]
script = ExtResource("1_7ahsg")
id = "event_01_attack"
label = "Insinuar que a queda foi sabotagem dos manifestantes"
response_text = "Convenientemente, o sinal caiu bem na hora de falar da marcha. Fico pensando quem teria interesse em atrapalhar esta transmissão."

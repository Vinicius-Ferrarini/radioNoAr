integrity_delta = -15
stance = 2

[resource]
script = ExtResource("2_by72b")
id = "event_01"
night = 1
headline = "Um silêncio de trinta segundos"
body = "No meio do jornal desta noite, bem quando você lia a nota sobre a marcha marcada para a Praça da República, o sinal caiu. Trinta segundos de silêncio no ar — uma eternidade em rádio. Quando voltou, um técnico do Ministério das Comunicações já estava na linha, garantindo que foi \"uma instabilidade pontual\". As luzes do estúdio nunca piscaram."
choices = Array[ExtResource("1_7ahsg")]([SubResource("Resource_yd868"), SubResource("Resource_k2icd"), SubResource("Resource_seidi")])

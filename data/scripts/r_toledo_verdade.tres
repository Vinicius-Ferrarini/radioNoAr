[gd_resource type="Resource" script_class="BroadcastScript" format=3]

[ext_resource type="Script" path="res://scripts/core/data/broadcast_script.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/core/data/script_line.gd" id="2_line"]
[ext_resource type="Script" path="res://scripts/core/data/forbidden_word_slot.gd" id="3_slot"]
[ext_resource type="Script" path="res://scripts/core/data/improv_point.gd" id="4_point"]
[ext_resource type="Script" path="res://scripts/core/data/improv_option.gd" id="5_option"]

[sub_resource type="Resource" id="line_1"]
script = ExtResource("2_line")
text = "Recebi hoje uma denúncia sobre um morador da Rua Aurora. Vou fazer uma coisa diferente com ela."
read_seconds = 6.0

[sub_resource type="Resource" id="opt_2"]
script = ExtResource("5_option")
id = "toledo_encerra"
text = "Foi só isso. Seguimos."
framing_kind = 2
immediate_deltas = {
"audience_trust": 1
}

[sub_resource type="Resource" id="opt_3"]
script = ExtResource("5_option")
id = "toledo_explica"
text = "Digo isso porque alguém quase teve a casa apedrejada por uma mensagem de celular."
framing_kind = 1
immediate_deltas = {
"audience_trust": 7,
"integrity": 6,
"regime_attention": 2
}
consequence_ids = Array[String](["c_denuncia_checada"])

[sub_resource type="Resource" id="opt_4"]
script = ExtResource("5_option")
id = "toledo_acusa"
text = "E eu quero saber quem ganha com essa história, porque ela não nasceu sozinha."
framing_kind = 3
immediate_deltas = {
"audience_trust": 5,
"integrity": 2,
"regime_attention": 8,
"street_heat": 6
}

[sub_resource type="Resource" id="point_5"]
script = ExtResource("4_point")
id = "i_toledo"
prompt = "Você acabou de desmentir quem te escreveu."
time_limit_seconds = 7.0
options = Array[ExtResource("5_option")]([SubResource("opt_2"), SubResource("opt_3"), SubResource("opt_4")])

[sub_resource type="Resource" id="line_6"]
script = ExtResource("2_line")
text = "A Rua Aurora foi evacuada anteontem de madrugada. Está vazia. Não havia ninguém lá para ser visto."
read_seconds = 6.0
improv_point = SubResource("point_5")

[sub_resource type="Resource" id="line_7"]
script = ExtResource("2_line")
text = "Se você mandou essa mensagem: eu conferi. É o meu trabalho conferir."
read_seconds = 5.0

[resource]
script = ExtResource("1_script")
id = "r_toledo_verdade"
lines = Array[ExtResource("2_line")]([SubResource("line_1"), SubResource("line_6"), SubResource("line_7")])

[gd_resource type="Resource" script_class="BroadcastScript" format=3]

[ext_resource type="Script" path="res://scripts/core/data/broadcast_script.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/core/data/script_line.gd" id="2_line"]
[ext_resource type="Script" path="res://scripts/core/data/forbidden_word_slot.gd" id="3_slot"]
[ext_resource type="Script" path="res://scripts/core/data/improv_point.gd" id="4_point"]
[ext_resource type="Script" path="res://scripts/core/data/improv_option.gd" id="5_option"]

[sub_resource type="Resource" id="line_1"]
script = ExtResource("2_line")
text = "Comunicado oficial número cento e quatorze. Leio na íntegra, como manda a lei."
read_seconds = 5.5

[sub_resource type="Resource" id="line_2"]
script = ExtResource("2_line")
text = "O Ministério informa que a Rua Aurora amanheceu em plena normalidade, com comércio aberto e circulação regular de moradores."
read_seconds = 7.5

[sub_resource type="Resource" id="opt_3"]
script = ExtResource("5_option")
id = "comunicado_engole"
text = "Foi o que o comunicado disse. Seguimos com a programação."
framing_kind = 0
immediate_deltas = {
"alignment": 4,
"audience_trust": -2,
"regime_attention": -4
}

[sub_resource type="Resource" id="opt_4"]
script = ExtResource("5_option")
id = "comunicado_musica"
text = "Vamos para a música. Acho que todo mundo entendeu."
framing_kind = 4
immediate_deltas = {
"audience_trust": 9,
"regime_attention": 12,
"street_heat": 5
}
consequence_ids = Array[String](["c_propaganda_ironizada"])

[sub_resource type="Resource" id="opt_5"]
script = ExtResource("5_option")
id = "comunicado_desmente"
text = "Eu não vou ler isso de novo sem dizer que é mentira."
framing_kind = 1
immediate_deltas = {
"audience_trust": 10,
"integrity": 8,
"regime_attention": 20,
"street_heat": 8
}

[sub_resource type="Resource" id="point_6"]
script = ExtResource("4_point")
id = "i_comunicado"
prompt = "Você deixou a frase no ar. Sete segundos de silêncio pesam."
time_limit_seconds = 6.0
options = Array[ExtResource("5_option")]([SubResource("opt_3"), SubResource("opt_4"), SubResource("opt_5")])

[sub_resource type="Resource" id="line_7"]
script = ExtResource("2_line")
text = "Plena normalidade. Na Rua Aurora. Que foi evacuada anteontem de madrugada."
read_seconds = 6.0
improv_point = SubResource("point_6")

[resource]
script = ExtResource("1_script")
id = "r_comunicado_ironia"
lines = Array[ExtResource("2_line")]([SubResource("line_1"), SubResource("line_2"), SubResource("line_7")])

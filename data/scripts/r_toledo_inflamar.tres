[sub_resource type="Resource" id="line_2"]
script = ExtResource("2_line")
text = "Na Rua Aurora, no sobrado do portão verde. Todo mundo naquele bairro sabe de quem eu estou falando."
read_seconds = 6.0

[sub_resource type="Resource" id="line_3"]
script = ExtResource("2_line")
text = "Eu não vou dizer o número. Mas eu também não vou fingir que não sei."
read_seconds = 5.0

[resource]
